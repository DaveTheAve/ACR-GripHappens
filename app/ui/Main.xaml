        <WrapPanel>
         <Button x:Name="SupportButton" Content="Preview support report" />
         <Button Content="Known issues &amp; updates" x:Name="KnownIssuesButton" />
        </WrapPanel>
        <TextBlock x:Name="OutputText" Text="No report created in this window." Style="{StaticResource Caption}" />
        <WrapPanel Margin="0,12,0,0">
         <Button x:Name="ShowOutputButton" Content="Show report" IsEnabled="False" />
         <Button x:Name="OpenTaskButton" Content="Open task folder" IsEnabled="False" />
         <Button x:Name="ReadHelpButton" Content="Read guide" />
        </WrapPanel>
        <Expander Header="Technical output">
         <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="220" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" />
        </Expander>
       </StackPanel>
      </Border>
      <Border BorderBrush="#A64450" Background="#281C23" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="Recovery" Foreground="#F2A8AD" FontWeight="SemiBold" />
        <TextBlock Text="Restore original game files. Your saves and verified backups are kept." Style="{StaticResource HelpText}" />
        <WrapPanel>
         <Button x:Name="RestoreButton" Content="Restore original game files" Style="{StaticResource DangerButton}" />
         <Button x:Name="OpenBackupsButton" Content="Open backups" />
        </WrapPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#191B25" BorderBrush="#343848" BorderThickness="0,1,0,0" Padding="20,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
     <TextBlock x:Name="ChangeCountText" Text="No game files changed" FontSize="15" FontWeight="SemiBold" />
     <TextBlock x:Name="ChangeHintText" Text="Choose settings, then review and apply." Style="{StaticResource Caption}" Margin="0,5,0,0" />
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="ResetRecordingButton" Content="Reset recording" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Discard this take and record again. Restart ACR's stage and pause first. Only this take's data and exported ZIP are deleted; earlier recordings are kept." />
     <Button x:Name="StopRecordingButton" Content="Stop &amp; save recording" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
     <Button x:Name="ApplyButton" Content="Review &amp; apply" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="3" Padding="20,8" Background="#111218">
   <DockPanel>
    <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="14,0,0,0" />
    <ProgressBar x:Name="TaskProgress" Width="55" Height="4" DockPanel.Dock="Left" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" />
    <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
   </DockPanel>
  </Border>
 </Grid>
</Window>